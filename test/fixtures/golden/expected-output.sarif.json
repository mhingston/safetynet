{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "safetynet",
          "version": "0.1.0",
          "rules": [
            {
              "id": "credential-aws"
            },
            {
              "id": "credential-github"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "credential-aws",
          "message": {
            "text": "AWS key detected"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/config.ts"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 5,
                  "startColumn": 0,
                  "endColumn": 20
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "abc123:src/config.ts:credential-aws:5"
          },
          "level": "error",
          "partialFingerprints": {
            "commitSha": "abc123"
          }
        },
        {
          "ruleId": "credential-github",
          "message": {
            "text": "GitHub token detected"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/auth.ts"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 10,
                  "startColumn": 2,
                  "endColumn": 30
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "def456:src/auth.ts:credential-github:10"
          },
          "level": "error",
          "partialFingerprints": {
            "commitSha": "def456"
          }
        }
      ]
    }
  ]
}